rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 允許所有已登入使用者去讀 users 下的 email
    match /users/{userId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null 
                   && request.auth.uid == userId;
    }

    // 只有本人可讀寫自己的 user document
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    match /profilePictures/{allPaths=**} {
      allow read: if request.auth.uid != null;
      allow write: if request.auth.uid != null;
    }

    // chatrooms 集合：允許已登入者建立；只有成員能讀；只有房主能改刪
    match /chatrooms/{roomId} {
      allow create: if request.auth != null;
      allow read:   if request.auth != null 
                    && request.auth.uid in resource.data.members;
      allow update, delete: if request.auth != null
                            && request.auth.uid == resource.data.ownerUid;
    }

    // messages 子集合：只限該 room 成員可讀寫
    match /chatrooms/{roomId}/messages/{msgId} {
      allow create, read: if request.auth != null
         && request.auth.uid in
            get(/databases/$(database)/documents/chatrooms/$(roomId)).data.members;
      allow update, delete: if false;
    }

    match /chatrooms/{roomId}/messages/{msgId} {
      allow create: if request.auth.uid != null;
    }

    // 其他路徑一律拒絕
    match /{document=**} {
      allow read, write: if false;
    }

    match /chatrooms/{roomId}/messages/{msgId} {
      allow delete: if request.auth != null
    && resource.data.senderUid == request.auth.uid;
}

  }
}
